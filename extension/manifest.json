{
  "manifest_version": 3,
  "name": "scholar-search bridge",
  "version": "0.3.3",
  "key": "",
  "description": "Read-only bibliographic retrieval bridge. Nine generic verbs, no site logic.",
  "permissions": ["nativeMessaging", "tabs"],
  "host_permissions": ["https://*.cnki.net/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*.cnki.net/*"],
      "js": ["content/actions.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}




